{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "archive-maintainer plain-text-v1 draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks", "excludedSourceRanges"],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blockType", "blockKey", "ordinal", "title", "titleSourceRanges", "paragraphs"],
        "properties": {
          "blockType": {"enum": ["PREFACE", "CHAPTER"]},
          "blockKey": {"type": "string", "pattern": "^(preface|chapter-[1-9][0-9]*)$"},
          "ordinal": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "titleSourceRanges": {"$ref": "#/$defs/ranges"},
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ordinal", "text", "sourceRanges"],
              "properties": {
                "ordinal": {"type": "integer", "minimum": 1},
                "text": {"type": "string", "minLength": 1},
                "sourceRanges": {"$ref": "#/$defs/ranges"}
              }
            }
          }
        }
      }
    },
    "excludedSourceRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startByte", "endByte", "reason"],
        "properties": {
          "startByte": {"type": "integer", "minimum": 0},
          "endByte": {"type": "integer", "minimum": 1},
          "reason": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      }
    }
  },
  "$defs": {
    "ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startByte", "endByte"],
        "properties": {
          "startByte": {"type": "integer", "minimum": 0},
          "endByte": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}